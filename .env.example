# okf-mcp-gateway environment. Copy to .env and fill in real values:
#
#     cp .env.example .env
#
# .env is gitignored — never commit real tokens. Values here are placeholders.

# North consumer auth (required). Shared bearer token every MCP consumer must
# send as `Authorization: Bearer <token>`; the gateway refuses to start without
# it. Generate one with e.g. `openssl rand -hex 32`.
OKF_GATEWAY_TOKEN=

# South git-host auth (optional; one per private host). The suffix after
# OKF_GIT_TOKEN_ is referenced by `token_env` in servers.yaml. Use a read-only
# access token. Leave unset for hosts that clone anonymously.
OKF_GIT_TOKEN_BITBUCKET=
